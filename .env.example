# QoderGateway environment example
# Copy this file to .env or set these variables in your shell.

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
QODER_HOST=127.0.0.1
QODER_PORT=5050

# 管理控制台密码。设置后会覆盖 SQLite 中保存的 gateway token
# （即环境变量优先级最高，控制台内修改将被忽略）。
QODER_ADMIN_PASSWORD=admin

# 出站代理。国内访问 qoder.sh 需要；仅此项控制代理，不读取 HTTP_PROXY 等环境变量。
# 聊天、鉴权、token 刷新、配额查询、注册机浏览器与邮箱 API 均走此代理。
# 示例：http://127.0.0.1:7890
QODER_PROXY=

# 静态页面开关。设为 0 / false / no / off 关闭。
QODER_ENABLE_DOCUMENTS=1
QODER_ENABLE_LANDING=1

# 数据目录（SQLite 存放位置）。容器中为 /data；留空则用 ~/.qoder
# QODER_DATA_DIR=/data

# 首次启动且无账号时自动导入的 PAT
QODER_PAT=

# ---------------------------------------------------------------------------
# 注册机浏览器与远程画面
# ---------------------------------------------------------------------------
# Chromium 可执行文件路径。容器内为 /usr/bin/chromium；
# Windows 本地运行留空即可（DrissionPage 会自动查找）
QODER_CHROMIUM_PATH=

# 是否 headless。注意：人机验证（阿里云滑块）无法在 headless 下完成，
# 仅用于调试，容器内请保持 0
QODER_CHROMIUM_HEADLESS=0

# 追加的 Chromium 启动参数（空格分隔）
QODER_CHROMIUM_ARGS=

# 远程浏览器：在 Web 控制台 Register 页签里直接查看并操作注册机的浏览器，
# 人机验证就在面板上拖动完成（已验证可穿透滑块所在的跨源 iframe）。
# 1 开启（默认），0 关闭。容器不开放 VNC。
# 注意：该通道等同于把浏览器完全交给控制台使用者，请确保控制台仅管理员可访问。
QODER_REMOTE_BROWSER=1
# 画面推送帧率上限（1-30），越低越省 CPU 与带宽
QODER_REMOTE_BROWSER_FPS=8
# JPEG 画质（10-95）
QODER_REMOTE_BROWSER_QUALITY=60

# 虚拟屏分辨率（有头 Chromium 需要 Xvfb，容器入口会自动启动）
QODER_SCREEN=1440x900x24

# ---------------------------------------------------------------------------
# 临时邮箱（注册机创建账号时收验证码）
#
# 推荐在 Web 控制台「注册机」页签里在线配置：设置写入 SQLite，保存后立即
# 生效，无需重启服务；敏感项在界面上以掩码显示，不会回传明文。
#
# 下面这些环境变量仅作为「首次部署的默认值 / 回退」——
# 控制台里保存过的值优先级更高，会覆盖这里。
# ---------------------------------------------------------------------------

# 后端选择：auto（配了 base 用 cloudflare，否则 yyds）/ cloudflare / yyds
# QODER_MAIL_PROVIDER=auto

# ---- cloudflare_temp_email（推荐）----------------------------------------
# 项目：https://github.com/dreamhunter2333/cloudflare_temp_email
# 你的部署地址，例如 https://mail.example.com
# CF_TEMP_EMAIL_BASE=
# 管理员密码（对应服务端 ADMIN_PASSWORDS）。
# 配置后走 /admin/new_address，可绕过 Turnstile 与「禁止匿名创建」限制。
# CF_TEMP_EMAIL_ADMIN_PASSWORD=
# 站点私有密码（对应服务端 SITE_PASSWORD / x-custom-auth）
# CF_TEMP_EMAIL_SITE_PASSWORD=
# 指定创建地址使用的域名；留空由服务端随机选择
# CF_TEMP_EMAIL_DOMAIN=
# Cloudflare Turnstile token（仅匿名模式且服务端强制校验时需要）
# CF_TEMP_EMAIL_CF_TOKEN=

# ---- yyds（旧方案）--------------------------------------------------------
# YYDS_API_KEY=
# YYDS_API_BASE=https://maliapi.215.im/v1
